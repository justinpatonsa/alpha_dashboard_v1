# Copy this file to .env (which is gitignored) and fill it in. Never commit .env.
# Paste values as-is: no quotes needed, and # or ! inside a value is fine.
SUPABASE_URL=https://qfqtowijmmceismaqzxw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# Dashboard sign-in: the team's own Postgres database (accounts + sessions), not Supabase.
# Local:  postgresql://localhost/alpha_dashboard_dev
# VPS:    postgresql:///mattvijayjustin?host=/var/run/postgresql   (peer auth, no password)
APP_DATABASE_URL=
# Session cookie is HTTPS-only by default; set 0 for plain http://localhost.
COOKIE_SECURE=1
